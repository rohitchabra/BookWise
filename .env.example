# Database — Supabase or Neon (PostgreSQL)
# Supabase: Project → Connect → Connection string → URI (Session/Transaction pooler)
# Replace [YOUR-PASSWORD] with your database password
DATABASE_URL=postgresql://postgres.kgaebofoqmizzrdgzeyx:[YOUR-PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres

# Auth.js
AUTH_SECRET=generate-with-openssl-rand-base64-32
# Optional: set in production
# AUTH_URL=https://your-domain.com

# Upstash Redis (rate limiting)
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token

# ImageKit
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY=your_public_key
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_id
IMAGEKIT_PRIVATE_KEY=your_private_key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
ADMIN_EMAIL=admin@bookwise.com
